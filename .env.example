FLASK_APP=run.py
FLASK_DEBUG=1
APP_ENV=development
SECRET_KEY=replace-with-a-long-random-value
COOKIE_SECURE=false
RATELIMIT_STORAGE_URI=memory://
TRUSTED_PROXY_HOPS=0
DATABASE_URL=sqlite:///job_matcher.db
APP_BASE_URL=http://127.0.0.1:5000
MAX_CONTENT_LENGTH_MB=10
# Use discard on Vercel: resumes are parsed in memory and originals are not retained.
RESUME_STORAGE_MODE=local
# Protects scheduler endpoints. Use a different random value from every other secret.
CRON_SECRET=

# Development prints OTPs in the terminal. Configure SMTP before production.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=Job Matcher <jobmatchersupport@gmail.com>
SUPPORT_EMAIL=jobmatchersupport@gmail.com
MAIL_USE_TLS=true

# Google Auth Platform OAuth 2.0 Web client (optional).
# Local callback: http://127.0.0.1:5000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Live job sources. The app works with clearly labelled demo data without these.
SEED_DEMO_JOBS=true
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in
GREENHOUSE_BOARDS=
LEVER_SITES=
ASHBY_BOARDS=
ENABLE_HIMALAYAS=true

# Create a bot with @BotFather. The webhook secret must be random and at least 16 characters.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Optional comma-separated list of administrator emails.
ADMIN_EMAILS=
